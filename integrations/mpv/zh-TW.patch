+# 個人設定：繁體中文與低負載預設
+slang=zh-TW,zh-Hant,zht,chi,zho,zh,en
+alang=ja,jpn,zh-TW,zh,en
+osd-font=Noto Sans TC
+sub-font=Noto Sans TC
+watch-later-directory=~~/watch_later
+# 不預設啟用插幀或超分；需要時從選單手動選取。
+interpolation=no
+# 保留原始影片色彩，避免額外提高對比與飽和度。
+contrast=0
+saturation=0
+volume=70
+volume=100
+mute=no
