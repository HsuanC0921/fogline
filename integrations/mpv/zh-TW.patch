--- a/script-opts/modernz.conf
+++ b/script-opts/modernz.conf
@@ -1,6 +1,6 @@
 # Language and display
 # set language (for available options, see: https://github.com/Demetter/ModernGlass/blob/main/docs/TRANSLATIONS.md)
-language=zh
+language=zh-TW
 # set layout: default (floating glass panel), classic, compact, mini, seekbar
 # in the default layout, speed, loop, keep on top, screenshot and statistics live in the ⋯ menu
 layout=default
@@ -9,7 +9,7 @@
 # set icon style. accepts mixed, filled, outline
 icon_style=mixed
 # UI font (Inter ships in the fonts folder)
-font=Inter
+font=Noto Sans TC
 
 # show mpv logo when idle
 idlescreen=yes
@@ -259,13 +259,13 @@
